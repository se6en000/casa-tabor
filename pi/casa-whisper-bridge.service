[Unit]
Description=Casa Tabor Whisper STT Bridge
After=network-online.target pipewire.service pipewire-pulse.service wireplumber.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=simple
WorkingDirectory=/home/jake/whisper-bridge
Environment=PATH=/home/jake/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/home/jake/.config/casa/whisper-bridge.env
ExecStart=/usr/bin/python3 /home/jake/whisper-bridge/main.py
Restart=on-failure
RestartSec=2
StandardOutput=append:/home/jake/whisper-bridge.log
StandardError=append:/home/jake/whisper-bridge.log

[Install]
WantedBy=default.target
